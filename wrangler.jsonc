{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-compleanni",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "birthday-bot-db",
      // Il segnaposto viene sostituito con l'ID reale da scripts/setup-bot.ps1 al primo deploy.
      "database_id": "REPLACE_ME",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Ciclo orario (UTC). Handler vuoto finché non arriva la feature promemoria.
    "crons": ["0 * * * *"]
  }
  // Nessun secret qui (RNF-04): TELEGRAM_BOT_TOKEN, OWNER_TELEGRAM_ID e WEBHOOK_SECRET
  // si impostano con `wrangler secret put` (o in .dev.vars in locale).
}
